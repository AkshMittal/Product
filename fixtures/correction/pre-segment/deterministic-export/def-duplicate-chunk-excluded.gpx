<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="test-fixture" xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <name>def-duplicate-chunk-excluded</name>
    <trkseg>
      <!-- Segment 0: times 10:00–10:30. Will be the 'from' segment. -->
      <trkpt lat="47.0000" lon="8.0000"><ele>500</ele><time>2024-01-01T10:00:00Z</time></trkpt>
      <trkpt lat="47.0010" lon="8.0000"><ele>501</ele><time>2024-01-01T10:15:00Z</time></trkpt>
      <trkpt lat="47.0020" lon="8.0000"><ele>502</ele><time>2024-01-01T10:30:00Z</time></trkpt>
    </trkseg>
    <trkseg>
      <!-- Segment 1: times 10:10–10:20. Overlaps segment 0's range.
           Boundary classification → 'duplicate_chunk'.
           applyDeterministicExportFixes drops ALL points in segment 1 (the 'to' segment).
           Profile mode → 'geometry-only', correctionIdle=true, exitReason='duplicate-chunk-excluded'.
           Expected: both points of seg 1 in drops[] with reason 'duplicate_chunk_segment'.
           Annotation 'duplicate_chunk_excluded' on seg 1. -->
      <trkpt lat="47.1000" lon="8.1000"><ele>510</ele><time>2024-01-01T10:10:00Z</time></trkpt>
      <trkpt lat="47.1010" lon="8.1000"><ele>511</ele><time>2024-01-01T10:20:00Z</time></trkpt>
    </trkseg>
    <trkseg>
      <!-- Segment 2: clean. Continues normally after excluded segment 1. -->
      <trkpt lat="47.2000" lon="8.2000"><ele>600</ele><time>2024-01-01T11:00:00Z</time></trkpt>
      <trkpt lat="47.2010" lon="8.2000"><ele>601</ele><time>2024-01-01T11:01:00Z</time></trkpt>
    </trkseg>
  </trk>
</gpx>
