<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="test-fixture" xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <name>od-adjacent-exact-oob-vs-usable</name>
    <trkseg>
      <!-- Point 0 (prev): OOB ele=10000 (> 9500).
           Point 1 (curr): same time+lat+lon, usable ele=500.
           Mixed oob/usable: treat OOB as absent → drop the OOB side (prev).
           Expected: point 0 dropped, point 1 (ele=500) survives.
           Adversarial: PREV is OOB (not curr). Tests that the drop goes to prev. -->
      <trkpt lat="47.0000" lon="8.0000"><ele>10000</ele><time>2024-01-01T10:00:00Z</time></trkpt>
      <trkpt lat="47.0000" lon="8.0000"><ele>500</ele><time>2024-01-01T10:00:00Z</time></trkpt>
      <trkpt lat="47.0010" lon="8.0010"><ele>501</ele><time>2024-01-01T10:01:00Z</time></trkpt>
    </trkseg>
  </trk>
</gpx>
