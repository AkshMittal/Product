<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="test-fixture" xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <name>od-non-consecutive-gpxindex-skip</name>
    <trkseg>
      <!-- All points in same segment, all with same time+lat+lon+ele.
           However, the deduplication check requires curr.gpxIndex === prev.gpxIndex + 1
           (stream-adjacent by GPX index, not just traversal-adjacent in the working array).
           When the pipeline has reordered points (or if gpxIndexes have gaps), non-consecutive
           pairs are NOT deduplicated here.
           This fixture has gpxIndex 0, 2, 4 (gaps of 2 each — simulating post-reorder state).
           After phase 1 reordering, the module must be run with original stream adjacency.
           At the pre-segment phase (BEFORE any mutation), gpxIndexes are sequential; this
           fixture therefore tests the case where ALL pairs ARE consecutive → all dropped except first.
           The adversarial pattern: 3 identical consecutive points.
           Expected: points 1 and 2 dropped (cascade), point 0 survives. -->
      <trkpt lat="47.0000" lon="8.0000"><ele>500</ele><time>2024-01-01T10:00:00Z</time></trkpt>
      <trkpt lat="47.0000" lon="8.0000"><ele>500</ele><time>2024-01-01T10:00:00Z</time></trkpt>
      <trkpt lat="47.0000" lon="8.0000"><ele>500</ele><time>2024-01-01T10:00:00Z</time></trkpt>
      <trkpt lat="47.0010" lon="8.0010"><ele>501</ele><time>2024-01-01T10:01:00Z</time></trkpt>
    </trkseg>
  </trk>
</gpx>
