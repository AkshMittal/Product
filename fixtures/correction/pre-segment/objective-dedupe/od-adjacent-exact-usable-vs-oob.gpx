  <trk>
    <name>od-adjacent-exact-usable-vs-oob</name>
    <trkseg>
      <!-- Point 0 (prev): usable ele=500.
           Point 1 (curr): same time+lat+lon, OOB ele=10000 (> 9500).
           Mixed usable/oob: treat OOB as absent → drop the OOB side (curr).
           Expected: point 1 dropped, point 0 (ele=500) survives unchanged. -->
      <trkpt lat="47.0000" lon="8.0000"><ele>500</ele><time>2024-01-01T10:00:00Z</time></trkpt>
      <trkpt lat="47.0000" lon="8.0000"><ele>10000</ele><time>2024-01-01T10:00:00Z</time></trkpt>
      <trkpt lat="47.0010" lon="8.0010"><ele>501</ele><time>2024-01-01T10:01:00Z</time></trkpt>
    </trkseg>
  </trk>
