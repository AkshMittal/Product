  <trk>
    <name>od-adjacent-exact-same-ele</name>
    <trkseg>
      <!-- Points 0 and 1 are stream-adjacent (gpxIndex 0,1), same trkSegIndex,
           same timeMs, same lat, same lon, same ele (500).
           Elevation table: both usable AND equal → drop curr (point 1).
           Expected: point 1 dropped with reason 'adjacent-exact-duplicate'. -->
      <trkpt lat="47.0000" lon="8.0000"><ele>500</ele><time>2024-01-01T10:00:00Z</time></trkpt>
      <trkpt lat="47.0000" lon="8.0000"><ele>500</ele><time>2024-01-01T10:00:00Z</time></trkpt>
