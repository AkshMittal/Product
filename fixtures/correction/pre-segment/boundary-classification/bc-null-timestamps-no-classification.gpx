           Edge case: tests the null-timestamp branch in classifySegmentBoundaries. -->
      <trkpt lat="47.1000" lon="8.1000"><ele>510</ele></trkpt>
      <trkpt lat="47.1020" lon="8.1000"><ele>512</ele></trkpt>
