<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="test-fixture" xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <name>bc-chunk-ordering</name>
    <trkseg>
      <!-- Segment 0: times 11:00–11:10. Appears AFTER segment 1 in the stream,
           but has LATER timestamps. This is a chunk that exported out of order. -->
      <trkpt lat="47.0000" lon="8.0000"><ele>500</ele><time>2024-01-01T11:00:00Z</time></trkpt>
      <trkpt lat="47.0010" lon="8.0000"><ele>501</ele><time>2024-01-01T11:05:00Z</time></trkpt>
      <trkpt lat="47.0020" lon="8.0000"><ele>502</ele><time>2024-01-01T11:10:00Z</time></trkpt>
    </trkseg>
    <trkseg>
      <!-- Segment 1: times 10:00–10:10. Stream-subsequent but time-earlier.
           lastT of seg 0 = 11:10, firstT of seg 1 = 10:00 → firstT < lastT → backward jump.
           deltaHours = 1h 10min ≈ 1.167h. nearestWhole = 1. |1.167 - 1| = 0.167 > tzTol(0.1).
           → NOT timestamp_discontinuity.
           seg0.minTimeMs (11:00) > seg1.maxTimeMs (10:10) → ranges non-overlapping.
           Expected: classification = 'chunk_ordering'. -->
      <trkpt lat="47.1000" lon="8.1000"><ele>510</ele><time>2024-01-01T10:00:00Z</time></trkpt>
      <trkpt lat="47.1010" lon="8.1000"><ele>511</ele><time>2024-01-01T10:05:00Z</time></trkpt>
      <trkpt lat="47.1020" lon="8.1000"><ele>512</ele><time>2024-01-01T10:10:00Z</time></trkpt>
    </trkseg>
  </trk>
</gpx>
