<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="test-fixture" xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <name>e2e-multi-anomaly-multi-segment</name>
    <trkseg>
      <!-- Segment 0: fully reversed (isFullyReversed=true).
           reversal-check: attempt per-segment reversal.
           Reversed seq: 10:00, 10:01, 10:02 → monotonic ✓.
           No prev seg → seam check: only next (seg 1 minTimeMs=11:00) vs revMax(10:02) ✓.
           Expected: segment reversal accepted. -->
      <trkpt lat="47.0000" lon="8.0000"><ele>500</ele><time>2024-01-01T10:02:00Z</time></trkpt>
      <trkpt lat="47.0010" lon="8.0000"><ele>501</ele><time>2024-01-01T10:01:00Z</time></trkpt>
      <trkpt lat="47.0020" lon="8.0000"><ele>502</ele><time>2024-01-01T10:00:00Z</time></trkpt>
    </trkseg>
    <trkseg>
      <!-- Segment 1: objective adjacent dedupe case.
           Points 3+4 are adjacent exact duplicates (same T, lat, lon, ele).
           Phase: objective-adjacent-dedupe drops point 4. -->
      <trkpt lat="47.1000" lon="8.1000"><ele>600</ele><time>2024-01-01T11:00:00Z</time></trkpt>
      <!-- dup pair: both T=11:01:00 -->
      <trkpt lat="47.1010" lon="8.1000"><ele>601</ele><time>2024-01-01T11:01:00Z</time></trkpt>
      <trkpt lat="47.1010" lon="8.1000"><ele>601</ele><time>2024-01-01T11:01:00Z</time></trkpt>
      <trkpt lat="47.1020" lon="8.1000"><ele>602</ele><time>2024-01-01T11:02:00Z</time></trkpt>
    </trkseg>
    <trkseg>
      <!-- Segment 2: timestamp_discontinuity (1h backward from seg 1 end at 11:02).
           Seg 2 starts at 10:02 → delta = 1.0h exactly → timestamp_discontinuity annotation.
           Seg 2 internal content: clean forward, but a block of 2 belowAnchor points.
           Phase 1 must fix the block. -->
      <trkpt lat="47.2000" lon="8.2000"><ele>700</ele><time>2024-01-01T10:02:00Z</time></trkpt>
      <!-- anchor T+4min -->
      <trkpt lat="47.2040" lon="8.2000"><ele>704</ele><time>2024-01-01T10:06:00Z</time></trkpt>
      <!-- block: T+1min, T+2min (both belowAnchor T+4min, consecutive) -->
      <trkpt lat="47.2010" lon="8.2000"><ele>701</ele><time>2024-01-01T10:03:00Z</time></trkpt>
      <trkpt lat="47.2020" lon="8.2000"><ele>702</ele><time>2024-01-01T10:04:00Z</time></trkpt>
      <trkpt lat="47.2050" lon="8.2000"><ele>705</ele><time>2024-01-01T10:07:00Z</time></trkpt>
    </trkseg>
  </trk>
</gpx>
