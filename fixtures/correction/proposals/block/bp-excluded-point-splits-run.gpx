    <name>bp-excluded-point-splits-run</name>
    <trkseg>
      <!-- Stream: T+0, T+300(anchor), T+60, T+120(EXCLUDED), T+180, T+240, T+360.
           belowAnchor: T+60, T+120, T+180, T+240 (all below 300).
           But T+120 is in excludedSet → it breaks the contiguous run.
           Expected: TWO block proposals:
             block1 = [gpxIndex 2] with time T+60 (terminated by excluded point)
             block2 = [gpxIndex 4, 5] with times [T+180, T+240] (after excluded point).
           This tests that excluded points break block continuity per the finaliseBlock logic. -->
