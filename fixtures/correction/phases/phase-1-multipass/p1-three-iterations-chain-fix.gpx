<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="test-fixture" xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <name>p1-three-iterations-chain-fix</name>
    <trkseg>
      <!-- Chain scenario: fixing anomaly 1 in pass 1 reveals anomaly 2 in pass 2,
           which reveals anomaly 3 in pass 3. Each pass applies exactly one proposal.
           Stream design: T0, T4, T1, T2, T3, T5 where T1 is belowAnchor under T4.
           After fixing T1: T0, T1, T4, T2, T3, T5 → T2 now belowAnchor under T4.
           After fixing T2: T0, T1, T2, T4, T3, T5 → T3 belowAnchor under T4.
           After fixing T3: T0, T1, T2, T3, T4, T5 → stable.
           This requires coupling NOT to block each individual singleton.
           Expected: exitReason='stable', iterationsRun ≥ 3.
           Note: speeds designed to be well below 80 kph (short distances, long times). -->
      <trkpt lat="47.0000" lon="8.0000"><ele>500</ele><time>2024-01-01T10:00:00Z</time></trkpt>
      <!-- anchor at T+240s -->
      <trkpt lat="47.0040" lon="8.0000"><ele>504</ele><time>2024-01-01T10:04:00Z</time></trkpt>
      <!-- singleton1: T+60s (belowAnchor T+240) — 444m in 60s ≈ 26 kph ✓ -->
      <trkpt lat="47.0010" lon="8.0000"><ele>501</ele><time>2024-01-01T10:01:00Z</time></trkpt>
      <!-- singleton2: T+120s — revealed after singleton1 fixed -->
      <trkpt lat="47.0020" lon="8.0000"><ele>502</ele><time>2024-01-01T10:02:00Z</time></trkpt>
      <!-- singleton3: T+180s — revealed after singleton2 fixed -->
      <trkpt lat="47.0030" lon="8.0000"><ele>503</ele><time>2024-01-01T10:03:00Z</time></trkpt>
      <trkpt lat="47.0050" lon="8.0000"><ele>505</ele><time>2024-01-01T10:05:00Z</time></trkpt>
    </trkseg>
  </trk>
</gpx>
